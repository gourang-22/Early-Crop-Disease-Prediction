# KrishiScan — Frontend Environment Variables
# Copy this file to frontend/.env and fill in your values

# Backend API URL (leave blank for local dev: http://localhost:8000)
# For Render deployment, set to your Render backend URL, e.g. https://krishiscan-api.onrender.com
VITE_API_URL=http://localhost:8000

# Groq API Key (optional, for KrishiBot voice transcription)
# Get your free key at: https://console.groq.com
VITE_GROQ_API_KEY=your_groq_api_key_here